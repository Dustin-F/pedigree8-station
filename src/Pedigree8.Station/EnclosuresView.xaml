<UserControl x:Class="Pedigree8.Station.EnclosuresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Background="{StaticResource Surface}" Height="84">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Content="‹  Back" MinWidth="130" Click="Back_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="Enclosures" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="SubtitleText" Foreground="{StaticResource Muted}" FontSize="16" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0">
                    <Button Style="{StaticResource FlatButton}" Content="Print labels" Click="PrintAll_Click" />
                    <Button Style="{StaticResource FlatButton}" Background="{StaticResource Green}" Foreground="#0D1117"
                            Content="+ New" Click="New_Click" />
                </StackPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" Padding="12">
                <ItemsControl x:Name="Tiles">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileButton}" Height="150" Tag="{Binding Id}" Click="Tile_Click"
                                    BorderBrush="{StaticResource Line}">
                                <StackPanel Margin="16,12">
                                    <TextBlock Text="{Binding Code}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TypeName}" FontSize="15" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding OccupantText}" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <Grid x:Name="NewPanel" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="20" Width="600" VerticalAlignment="Top" Margin="0,60,0,0">
                <StackPanel>
                    <TextBlock Text="New enclosure — give it a short code" FontSize="22" FontWeight="SemiBold" Margin="4,0,0,12" />
                    <TextBox x:Name="NewCode" FontSize="26" Padding="10" Margin="6" CharacterCasing="Upper"
                             Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Ink}" BorderBrush="{StaticResource Line}" />
                    <TextBlock x:Name="NewError" Foreground="{StaticResource Red}" FontSize="16" Margin="8,0" />
                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource FlatButton}" Content="Cancel" Click="CancelNew_Click" />
                        <Button Style="{StaticResource FlatButton}" Background="{StaticResource Green}" Foreground="#0D1117" Content="Create" Click="CreateNew_Click" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
