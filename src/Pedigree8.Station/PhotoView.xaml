<UserControl x:Class="Pedigree8.Station.PhotoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Background="{StaticResource Surface}" Height="84">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource FlatButton}" Content="‹  Done" MinWidth="130" Click="Done_Click" />
                <StackPanel VerticalAlignment="Center" Margin="12,0">
                    <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="CameraText" Foreground="{StaticResource Muted}" FontSize="16" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="SwitchButton" Style="{StaticResource FlatButton}" Content="Switch camera" HorizontalAlignment="Right"
                    Visibility="Collapsed" Margin="12" Click="Switch_Click" />
        </Grid>
        <Grid Background="Black">
            <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
            <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Background="#CC1B1E22" CornerRadius="12" Padding="16,8">
                <TextBlock x:Name="StatusText" FontSize="20" Text="Starting camera…" />
            </Border>
            <Button x:Name="ShutterButton" Style="{StaticResource BigAction}" Background="{StaticResource Green}" Content="TAKE PHOTO"
                    Width="300" Height="110" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                    IsEnabled="False" Click="Shutter_Click" />
        </Grid>
    </DockPanel>
</UserControl>
