<UserControl x:Class="Pedigree8.Station.BreedingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Background="{StaticResource Surface}" Height="84">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Content="‹  Back" MinWidth="130" Click="Back_Click" />
                    <TextBlock Text="Breeding" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
                </StackPanel>
                <Button Style="{StaticResource FlatButton}" Background="{StaticResource Green}" Foreground="#0D1117"
                        Content="+ New pairing" HorizontalAlignment="Right" Margin="12" Click="NewPairing_Click" />
            </Grid>

            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Pairings" FontSize="20" FontWeight="SemiBold" Margin="8,0,0,6" />
                    <TextBlock x:Name="NoPairings" DockPanel.Dock="Top" Text="No pairings yet. Tap “+ New pairing” when you introduce a male to a female."
                               FontSize="18" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="8" />
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl x:Name="Pairings">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FlatButton}" Tag="{Binding Id}" Click="Pairing_Click" Height="84"
                                            HorizontalContentAlignment="Stretch" Padding="16,0">
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Title}" FontSize="22" />
                                            <TextBlock FontSize="15" FontWeight="Normal" Foreground="{StaticResource Muted}">
                                                <Run Text="{Binding PairedOn, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ResultText, Mode=OneWay}" /><Run Text="  ·  egg sacs: " /><Run Text="{Binding BroodCount, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <Border Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="12" Margin="12,0,0,0" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <StackPanel>
                            <StackPanel x:Name="PairingDetail" Visibility="Collapsed">
                                <TextBlock x:Name="PairingTitle" FontSize="26" FontWeight="Bold" Margin="6,0" />
                                <TextBlock x:Name="PairingSubtitle" FontSize="16" Foreground="{StaticResource Muted}" Margin="6,0,0,8" />
                                <TextBlock Text="How did it go?" FontSize="16" Foreground="{StaticResource Muted}" Margin="6,8,0,0" />
                                <WrapPanel x:Name="ResultChips" />
                                <Button Style="{StaticResource FlatButton}" Background="{StaticResource Purple}" Foreground="#0D1117"
                                        Content="Egg sac laid today" Margin="6,16,6,6" Click="EggSac_Click" />
                            </StackPanel>
                            <TextBlock x:Name="BroodsHeading" Text="All egg sacs / broods" FontSize="20" FontWeight="SemiBold" Margin="6,16,0,6" />
                            <TextBlock x:Name="NoBroods" Text="None yet." FontSize="17" Foreground="{StaticResource Muted}" Margin="6" />
                            <ItemsControl x:Name="Broods">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource FlatButton}" Tag="{Binding Id}" Click="Brood_Click" Height="76"
                                                HorizontalContentAlignment="Stretch" Padding="16,0">
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock FontSize="21"><Run Text="{Binding Code, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Parents, Mode=OneWay}" FontWeight="Normal" /></TextBlock>
                                                <TextBlock FontSize="15" FontWeight="Normal" Foreground="{StaticResource Muted}">
                                                    <Run Text="laid " /><Run Text="{Binding LaidOn, Mode=OneWay, TargetNullValue='?'}" /><Run Text="  ·  spiderlings: " /><Run Text="{Binding OffspringCount, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>

        <Grid x:Name="NewPanel" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="16" Margin="30">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBlock Text="New pairing" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FlatButton}" Content="Cancel" Click="CancelNew_Click" />
                            <Button Style="{StaticResource FlatButton}" Background="{StaticResource Green}" Foreground="#0D1117" Content="Save" Click="SaveNew_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="NewError" DockPanel.Dock="Bottom" Foreground="{StaticResource Red}" FontSize="17" Margin="8,4" />
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <StackPanel>
                            <TextBlock Text="Female" FontSize="17" Foreground="{StaticResource Muted}" Margin="8,10,0,0" />
                            <WrapPanel x:Name="FemaleChips" />
                            <TextBlock Text="Male" FontSize="17" Foreground="{StaticResource Muted}" Margin="8,14,0,0" />
                            <WrapPanel x:Name="MaleChips" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
