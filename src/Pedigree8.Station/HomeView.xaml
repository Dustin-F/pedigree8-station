<UserControl x:Class="Pedigree8.Station.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Background="{StaticResource Surface}" Height="84">
            <StackPanel VerticalAlignment="Center" Margin="24,0">
                <TextBlock x:Name="TitleText" Text="Pedigree8 Station" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource Muted}" FontSize="16" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0">
                <Button Style="{StaticResource FlatButton}" Background="{StaticResource Purple}" Foreground="#0D1117"
                        Content="Scan" Click="Scan_Click" />
                <Button Style="{StaticResource FlatButton}" Background="{StaticResource Green}" Foreground="#0D1117"
                        Content="Feed all" Click="FeedAll_Click" />
                <Button Style="{StaticResource FlatButton}" Background="{StaticResource Blue}" Foreground="#0D1117"
                        Content="Mist all" Click="MistAll_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" Padding="12">
          <StackPanel>
            <WrapPanel x:Name="FilterChips" Margin="2,0,0,4" />
            <TextBlock x:Name="AllDoneText" Text="✓  Everyone is fed and misted. Nothing to do right now."
                       FontSize="22" Foreground="{StaticResource Green}" Margin="12,24" Visibility="Collapsed" />
            <ItemsControl x:Name="Tiles">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="Tile" Style="{StaticResource TileButton}" Tag="{Binding Id}" Click="Tile_Click"
                                BorderBrush="{Binding FeedingLevel, Converter={StaticResource LevelBrush}}">
                            <Grid Margin="16,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Code}" FontSize="32" FontWeight="Bold" />
                                <TextBlock Grid.Row="1" Foreground="{StaticResource Muted}" FontSize="16" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding LifeStageName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding MorphName, Mode=OneWay}" />
                                </TextBlock>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Badge}" Background="{StaticResource Purple}"
                                            Visibility="{Binding InPremolt, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Text="PREMOLT" FontSize="14" FontWeight="Bold" Foreground="#0D1117" />
                                    </Border>
                                    <Border x:Name="StatusBadge" Style="{StaticResource Badge}" Background="{StaticResource Grey}" Visibility="Collapsed">
                                        <TextBlock Text="{Binding Status}" FontSize="14" FontWeight="Bold" Foreground="#0D1117" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <Ellipse Width="14" Height="14" Margin="0,0,8,0" Fill="{Binding FeedingLevel, Converter={StaticResource LevelBrush}}" />
                                    <TextBlock FontSize="20"><Run Text="Fed " /><Run Text="{Binding FedShort, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="14" Height="14" Margin="0,0,8,0" Fill="{Binding HydrationLevel, Converter={StaticResource LevelBrush}}" />
                                    <TextBlock FontSize="20"><Run Text="Misted " /><Run Text="{Binding MistedShort, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAlive}" Value="False">
                                <Setter TargetName="Tile" Property="Opacity" Value="0.5" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Line}" />
                                <Setter TargetName="StatusBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="2,8,0,0">
                <Button Style="{StaticResource FlatButton}" Content="+ New spider" Click="NewSpider_Click" />
                <Button Style="{StaticResource FlatButton}" Content="Enclosures" Click="Enclosures_Click" />
                <Button Style="{StaticResource FlatButton}" Content="Breeding" Click="Breeding_Click" />
                <Button x:Name="ShowAllButton" Style="{StaticResource FlatButton}" Click="ShowAll_Click" />
                <Button Style="{StaticResource FlatButton}" Content="Backup &amp; settings" Click="Settings_Click" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
