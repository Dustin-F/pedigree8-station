<Window x:Class="Pedigree8.Station.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pedigree8 Station" Width="1024" Height="768" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI" FontSize="18"
        Stylus.IsPressAndHoldEnabled="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <ContentControl x:Name="Host" />

        <Border x:Name="UndoBar" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,24" Background="#2D333B" CornerRadius="14" Padding="24,8,8,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="UndoText" VerticalAlignment="Center" FontSize="22" Margin="0,0,24,0" />
                <Button x:Name="UndoButton" Content="UNDO" Style="{StaticResource FlatButton}"
                        Background="{StaticResource Yellow}" Foreground="#0D1117" MinWidth="140" Click="Undo_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
