<UserControl x:Class="Pedigree8.Station.SpiderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Background="{StaticResource Surface}" Height="84">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Content="‹  Back" MinWidth="130" Click="Back_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="12,0">
                        <TextBlock FontSize="30" FontWeight="Bold">
                            <Run x:Name="CodeText" /><Run x:Name="NameText" Foreground="{StaticResource Muted}" FontWeight="Normal" FontSize="22" />
                        </TextBlock>
                        <TextBlock x:Name="SubtitleText" Foreground="{StaticResource Muted}" FontSize="16" />
                    </StackPanel>
                </StackPanel>
                <Border x:Name="StatusBadge" Style="{StaticResource Badge}" Background="{StaticResource Grey}" Visibility="Collapsed"
                        HorizontalAlignment="Right" Margin="0,0,24,0">
                    <TextBlock x:Name="StatusText" FontSize="18" FontWeight="Bold" Foreground="#0D1117" />
                </Border>
            </Grid>

            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*" />
                    <ColumnDefinition Width="9*" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" CornerRadius="12" Margin="8" Padding="16,12">
                        <StackPanel>
                            <TextBlock x:Name="PremoltText" FontSize="18" Foreground="{StaticResource Purple}" FontWeight="SemiBold" Visibility="Collapsed" />
                            <TextBlock x:Name="DetailText" FontSize="17" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <UniformGrid Rows="2" Columns="2">
                        <Button x:Name="FedButton" Style="{StaticResource BigAction}" Background="{StaticResource Green}" Click="Fed_Click">
                            <StackPanel>
                                <TextBlock Text="FED" HorizontalAlignment="Center" />
                                <TextBlock x:Name="FedLast" FontSize="16" FontWeight="Normal" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MistedButton" Style="{StaticResource BigAction}" Background="{StaticResource Blue}" Click="Misted_Click">
                            <StackPanel>
                                <TextBlock Text="MISTED" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MistedLast" FontSize="16" FontWeight="Normal" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MoltedButton" Style="{StaticResource BigAction}" Background="{StaticResource Purple}" Click="Molted_Click">
                            <StackPanel>
                                <TextBlock Text="MOLTED" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MoltedLast" FontSize="16" FontWeight="Normal" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BigAction}" Background="{StaticResource Surface2}" Foreground="{StaticResource Ink}" Click="More_Click">
                            <StackPanel>
                                <TextBlock Text="MORE" HorizontalAlignment="Center" />
                                <TextBlock Text="note · sex · status · family" FontSize="16" FontWeight="Normal" HorizontalAlignment="Center"
                                           Foreground="{StaticResource Muted}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </DockPanel>

                <DockPanel Grid.Column="1" Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="History" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,8" />
                    <TextBlock DockPanel.Dock="Bottom" Text="Tap an entry to change its date or details" FontSize="14" Foreground="{StaticResource Muted}" Margin="4,6,0,0" />
                    <Border Background="{StaticResource Surface}" CornerRadius="12">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <ItemsControl x:Name="History" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Id}" Click="HistoryRow_Click" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="10,8">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface2}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,8,0,0" Fill="{Binding Brush}" />
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock FontSize="18" Foreground="{StaticResource Ink}">
                                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding When, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="15" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Detail}" FontSize="15" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisible}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>
        </DockPanel>

        <!-- MORE menu -->
        <Grid x:Name="MorePanel" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="16" Width="900" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="More" FontSize="24" FontWeight="SemiBold" Margin="8,0,0,8" />
                    <UniformGrid Columns="3">
                        <Button Style="{StaticResource FlatButton}" Height="72" Content="Refused food" Click="Refused_Click" />
                        <Button Style="{StaticResource FlatButton}" Height="72" Content="Write a note" Click="Note_Click" />
                        <Button Style="{StaticResource FlatButton}" Height="72" Content="Health issue" Click="Health_Click" />
                        <Button Style="{StaticResource FlatButton}" Height="72" Content="Photos" Click="Photos_Click" />
                        <Button Style="{StaticResource FlatButton}" Height="72" Content="Measure" Click="Measure_Click" />
                        <Button Style="{StaticResource FlatButton}" Height="72" Content="Care schedule" Click="Schedule_Click" />
                        <Button x:Name="PremoltButton" Style="{StaticResource FlatButton}" Height="72" Click="Premolt_Click" />
                        <Button Style="{StaticResource FlatButton}" Height="72" Content="Set sex" Click="Sex_Click" />
                        <Button Style="{StaticResource FlatButton}" Height="72" Content="Instar" Click="Stage_Click" />
                        <Button Style="{StaticResource FlatButton}" Height="72" Content="Move enclosure" Click="MoveEnclosure_Click" />
                        <Button Style="{StaticResource FlatButton}" Height="72" Content="Enclosure details" Click="EnclosureDetails_Click" />
                        <Button Style="{StaticResource FlatButton}" Height="72" Content="Family tree" Click="Family_Click" />
                        <Button Style="{StaticResource FlatButton}" Height="72" Content="Name &amp; notes" Click="NameNotes_Click" />
                        <Button Style="{StaticResource FlatButton}" Height="72" Content="Status (sold, died…)" Foreground="{StaticResource Orange}" Click="Status_Click" />
                        <Button Style="{StaticResource FlatButton}" Height="72" Content="Close" Click="ClosePanels_Click" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Entry: note / health / sex / stage / status / name -->
        <Grid x:Name="TextPanel" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="20" Width="820" VerticalAlignment="Top" Margin="0,30,0,0">
                <StackPanel>
                    <TextBlock x:Name="TextPanelTitle" FontSize="24" FontWeight="SemiBold" Margin="4,0,0,12" TextWrapping="Wrap" />
                    <WrapPanel x:Name="ChoiceRow" />
                    <TextBox x:Name="NameBox" FontSize="22" Margin="6" Padding="10" Visibility="Collapsed"
                             Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Ink}"
                             BorderBrush="{StaticResource Line}" />
                    <TextBox x:Name="EntryText" FontSize="22" MinHeight="120" Margin="6" Padding="10" TextWrapping="Wrap" AcceptsReturn="True"
                             Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Ink}"
                             BorderBrush="{StaticResource Line}" VerticalScrollBarVisibility="Auto" />
                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource FlatButton}" Content="Cancel" Click="ClosePanels_Click" />
                        <Button x:Name="SaveButton" Style="{StaticResource FlatButton}" Background="{StaticResource Green}" Foreground="#0D1117"
                                Content="Save" Click="Save_Click" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Pick an enclosure to move to -->
        <Grid x:Name="MovePanel" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="16" Margin="40">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBlock Text="Move to which enclosure?" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                        <Button Style="{StaticResource FlatButton}" Content="Cancel" HorizontalAlignment="Right" Click="ClosePanels_Click" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <ItemsControl x:Name="EnclosureChoices">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FlatButton}" Height="96" Tag="{Binding Id}" Click="EnclosureChoice_Click">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Code}" FontSize="22" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding OccupantText}" FontSize="15" FontWeight="Normal"
                                                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Family tree -->
        <Grid x:Name="FamilyPanel" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="16" Margin="30">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBlock Text="Family tree" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                        <Button Style="{StaticResource FlatButton}" Content="Close" HorizontalAlignment="Right" Click="ClosePanels_Click" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <StackPanel x:Name="FamilyContent" Margin="4" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Photos -->
        <Grid x:Name="PhotosPanel" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="16" Margin="30">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBlock x:Name="PhotosTitle" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FlatButton}" Background="{StaticResource Green}" Foreground="#0D1117" Content="Take photo" Click="TakePhoto_Click" />
                            <Button Style="{StaticResource FlatButton}" Content="Close" Click="ClosePanels_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <WrapPanel x:Name="PhotoThumbs" Margin="4" />
                        </ScrollViewer>
                        <Grid x:Name="PhotoLarge" Background="{StaticResource Surface}" Visibility="Collapsed">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource FlatButton}" Content="‹ All photos" Click="PhotoBack_Click" />
                                    <Button Style="{StaticResource FlatButton}" Content="Remove photo" Foreground="{StaticResource Red}" Click="PhotoRemove_Click" />
                                </StackPanel>
                                <TextBlock x:Name="PhotoDate" DockPanel.Dock="Bottom" FontSize="16" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                <Image x:Name="PhotoLargeImage" Stretch="Uniform" Margin="4" />
                            </DockPanel>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Measure -->
        <Grid x:Name="MeasurePanel" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="20" Margin="40">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Body length" FontSize="24" FontWeight="SemiBold" Margin="4,0,0,8" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource FlatButton}" Content="−1" Tag="-1" Click="LengthStep_Click" />
                        <Button Style="{StaticResource FlatButton}" Content="−0.1" Tag="-0.1" Click="LengthStep_Click" />
                        <TextBlock x:Name="LengthText" FontSize="40" FontWeight="Bold" Width="200" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource FlatButton}" Content="+0.1" Tag="0.1" Click="LengthStep_Click" />
                        <Button Style="{StaticResource FlatButton}" Content="+1" Tag="1" Click="LengthStep_Click" />
                    </StackPanel>
                    <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,8">
                        <Button Style="{StaticResource FlatButton}" Content="Cancel" Click="ClosePanels_Click" />
                        <Button Style="{StaticResource FlatButton}" Background="{StaticResource Green}" Foreground="#0D1117" Content="Save measurement" Click="SaveMeasure_Click" />
                    </UniformGrid>
                    <TextBlock DockPanel.Dock="Top" Text="Growth so far" FontSize="18" FontWeight="SemiBold" Margin="6,8,0,4" />
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <StackPanel x:Name="GrowthList" Margin="6,0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Care schedule -->
        <Grid x:Name="SchedulePanel" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="20" Width="900" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ScheduleTitle" FontSize="24" FontWeight="SemiBold" Margin="4,0,0,4" />
                    <TextBlock Text="Colours on the home screen follow this. “Standard” uses the usual rule (green up to 1 day, red after a week)."
                               FontSize="16" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="6,0,0,8" />
                    <TextBlock Text="Feed every" FontSize="17" Foreground="{StaticResource Muted}" Margin="6,8,0,0" />
                    <WrapPanel x:Name="FeedEveryChips" />
                    <TextBlock Text="Mist every" FontSize="17" Foreground="{StaticResource Muted}" Margin="6,8,0,0" />
                    <WrapPanel x:Name="MistEveryChips" />
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <Button Style="{StaticResource FlatButton}" Content="Cancel" Click="ClosePanels_Click" />
                        <Button Style="{StaticResource FlatButton}" Background="{StaticResource Green}" Foreground="#0D1117" Content="Save" Click="SaveSchedule_Click" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Edit (or remove) a history entry -->
        <Grid x:Name="RemovePanel" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="16" Margin="24">
                <DockPanel>
                    <TextBlock x:Name="EditTitle" DockPanel.Dock="Top" FontSize="24" FontWeight="SemiBold" Margin="6,0,0,6" />
                    <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RemoveButton" Style="{StaticResource FlatButton}" Foreground="{StaticResource Red}" Content="Remove entry" Click="ConfirmRemove_Click" />
                        <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="Cancel" Click="ClosePanels_Click" />
                        <Button Grid.Column="2" Style="{StaticResource FlatButton}" Background="{StaticResource Green}" Foreground="#0D1117" Content="Save changes" Click="SaveEdit_Click" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Date" FontSize="18" Foreground="{StaticResource Muted}" Width="90" VerticalAlignment="Center" Margin="6,0" />
                                <Button Style="{StaticResource FlatButton}" Content="−1 day" Click="EditDateMinus_Click" />
                                <TextBlock x:Name="EditDateText" FontSize="24" FontWeight="Bold" Width="220" TextAlignment="Center" VerticalAlignment="Center" />
                                <Button x:Name="EditDatePlus" Style="{StaticResource FlatButton}" Content="+1 day" Click="EditDatePlus_Click" />
                                <Button Style="{StaticResource FlatButton}" Content="Today" Click="EditDateToday_Click" />
                            </StackPanel>

                            <StackPanel x:Name="FeedingFields">
                                <TextBlock Text="How did it go?" FontSize="17" Foreground="{StaticResource Muted}" Margin="6,8,0,0" />
                                <WrapPanel x:Name="OutcomeChips" />
                                <TextBlock Text="Food" FontSize="17" Foreground="{StaticResource Muted}" Margin="6,8,0,0" />
                                <WrapPanel x:Name="PreyChips" />
                                <StackPanel x:Name="NewPreyRow" Orientation="Horizontal" Visibility="Collapsed">
                                    <TextBox x:Name="NewPreyBox" FontSize="20" Width="300" Margin="6" Padding="8,4"
                                             Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Ink}" BorderBrush="{StaticResource Line}" />
                                    <Button Style="{StaticResource FlatButton}" Content="Add food" Click="AddPrey_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="How many" FontSize="17" Foreground="{StaticResource Muted}" Width="90" VerticalAlignment="Center" Margin="6,0" />
                                    <Button Style="{StaticResource FlatButton}" Content="−" Click="QuantityMinus_Click" />
                                    <TextBlock x:Name="QuantityText" FontSize="24" FontWeight="Bold" Width="80" TextAlignment="Center" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource FlatButton}" Content="+" Click="QuantityPlus_Click" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="ActionFields">
                                <TextBlock x:Name="ActionLabel" FontSize="17" Foreground="{StaticResource Muted}" Margin="6,8,0,0" />
                                <WrapPanel x:Name="ActionChips" />
                            </StackPanel>

                            <TextBlock Text="Note" FontSize="17" Foreground="{StaticResource Muted}" Margin="6,8,0,0" />
                            <TextBox x:Name="EditNotes" FontSize="20" MinHeight="70" Margin="6" Padding="8" TextWrapping="Wrap" AcceptsReturn="True"
                                     Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Ink}" BorderBrush="{StaticResource Line}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
