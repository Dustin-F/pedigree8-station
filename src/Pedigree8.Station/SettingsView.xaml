<UserControl x:Class="Pedigree8.Station.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="6,0,0,4" />
        </Style>
        <Style x:Key="Info" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="6,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Background="{StaticResource Surface}" Height="84">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Content="‹  Back" MinWidth="130" Click="Back_Click" />
                    <TextBlock Text="Backup &amp; settings" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
                </StackPanel>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" Padding="12">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Backups" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="BackupStatus" Style="{StaticResource Info}" />
                            <WrapPanel>
                                <Button x:Name="BackupNowButton" Style="{StaticResource FlatButton}" Content="Back up now" Click="BackupNow_Click" />
                                <Button x:Name="UsbButton" Style="{StaticResource FlatButton}" Background="{StaticResource Blue}" Foreground="#0D1117" Click="BackupUsb_Click" />
                                <Button Style="{StaticResource FlatButton}" Content="Restore a backup…" Click="ShowRestore_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="BackupResult" Style="{StaticResource Info}" Margin="6,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Station" Style="{StaticResource CardTitle}" />
                            <WrapPanel>
                                <Button x:Name="FullScreenButton" Style="{StaticResource FlatButton}" Click="FullScreen_Click" />
                                <Button x:Name="AutoStartButton" Style="{StaticResource FlatButton}" Click="AutoStart_Click" />
                                <Button Style="{StaticResource FlatButton}" Content="Close the app" Foreground="{StaticResource Orange}" Click="Close_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Info}" />
                            <WrapPanel>
                                <Button x:Name="CheckUpdateButton" Style="{StaticResource FlatButton}" Content="Check for updates" Click="CheckUpdate_Click" />
                                <Button x:Name="InstallUpdateButton" Style="{StaticResource FlatButton}" Background="{StaticResource Green}" Foreground="#0D1117"
                                        Visibility="Collapsed" Click="InstallUpdate_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="About" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="AboutInfo" Style="{StaticResource Info}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Grid x:Name="RestorePanel" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="16" Margin="30">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBlock x:Name="RestoreTitle" Text="Choose a backup to restore" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                        <Button Style="{StaticResource FlatButton}" Content="Cancel" HorizontalAlignment="Right" Click="CloseRestore_Click" />
                    </Grid>
                    <StackPanel x:Name="ConfirmRow" DockPanel.Dock="Bottom" Visibility="Collapsed">
                        <TextBlock x:Name="ConfirmText" FontSize="18" TextWrapping="Wrap" Margin="8" />
                        <Button Style="{StaticResource FlatButton}" Background="{StaticResource Orange}" Foreground="#0D1117"
                                Content="Restore and restart" HorizontalAlignment="Left" Click="ConfirmRestore_Click" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <StackPanel x:Name="BackupList" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
