<UserControl x:Class="Pedigree8.Station.BroodView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Background="{StaticResource Surface}" Height="84">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource FlatButton}" Content="‹  Back" MinWidth="130" Click="Back_Click" />
                <StackPanel VerticalAlignment="Center" Margin="12,0">
                    <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Foreground="{StaticResource Muted}" FontSize="16" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" Padding="12">
            <StackPanel>
                <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="12">
                    <StackPanel x:Name="DateRows" />
                </Border>

                <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Eggs (estimate)" FontSize="20" Width="190" VerticalAlignment="Center" Margin="8,0" />
                        <Button Style="{StaticResource FlatButton}" Content="−" Click="EggsMinus_Click" />
                        <TextBlock x:Name="EggText" FontSize="26" FontWeight="Bold" Width="90" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource FlatButton}" Content="+" Click="EggsPlus_Click" />
                        <Button Style="{StaticResource FlatButton}" Content="+10" Click="EggsPlusTen_Click" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="OffspringHeading" FontSize="20" FontWeight="SemiBold" Margin="8,0" />
                        <WrapPanel x:Name="OffspringRow" Margin="0,4" />
                        <TextBlock Text="Add spiderlings as individuals (each gets its own code and tile)" FontSize="16"
                                   Foreground="{StaticResource Muted}" Margin="8,12,0,0" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource FlatButton}" Content="−" Click="CountMinus_Click" />
                            <TextBlock x:Name="CountText" FontSize="26" FontWeight="Bold" Width="70" TextAlignment="Center" VerticalAlignment="Center" />
                            <Button Style="{StaticResource FlatButton}" Content="+" Click="CountPlus_Click" />
                            <Button Style="{StaticResource FlatButton}" Content="+10" Click="CountPlusTen_Click" />
                            <Button x:Name="AddButton" Style="{StaticResource FlatButton}" Background="{StaticResource Green}" Foreground="#0D1117"
                                    Margin="24,6,6,6" Click="AddOffspring_Click" />
                        </StackPanel>
                        <TextBlock Text="Their instar" FontSize="16" Foreground="{StaticResource Muted}" Margin="8,8,0,0" />
                        <WrapPanel x:Name="StageChips" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
